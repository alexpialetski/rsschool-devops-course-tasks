{
  "name": "api-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/api-server/src",
  "projectType": "application",
  "tags": ["type:app", "scope:api"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api-server:build",
        "runBuildTargetDependencies": false,
        "watch": true
      },
      "configurations": {
        "development": {
          "buildTarget": "api-server:build:development"
        },
        "production": {
          "buildTarget": "api-server:build:production"
        }
      }
    },
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "cache": true,
      "defaultConfiguration": "development",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "packages/api-server/dist",
        "main": "packages/api-server/src/main.ts",
        "tsConfig": "packages/api-server/tsconfig.app.json",
        "assets": ["packages/api-server/src/assets"],
        "webpackConfig": "packages/api-server/webpack.config.js"
      },
      "configurations": {
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "inspect": false
        },
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/api-server/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "defaultConfiguration": "local",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "local": {
          "command": "docker build -f ./Dockerfile -t api-server:latest ."
        }
      }
    },
    "docker-run": {
      "executor": "nx:run-commands",
      "dependsOn": ["docker-build"],
      "defaultConfiguration": "local",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "local": {
          "command": "docker run --rm -p 3000:3000 -p 9090:9090 --name api-server api-server:latest"
        }
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "dependsOn": ["docker-build"],
      "defaultConfiguration": "local",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "local": {
          "command": "minikube image load api-server:latest"
        }
      }
    }
  }
}
